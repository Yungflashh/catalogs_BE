PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/catalog
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173
NODE_ENV=development

# Cloudinary — get these from https://console.cloudinary.com/settings/api-keys
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Telegram notifications — leave blank to disable. Get token from @BotFather;
# get chat_id by messaging your bot then calling https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Chat bridge — a long random string. After deploy, register the webhook with:
# curl -X POST "https://api.telegram.org/bot<TOKEN>/setWebhook" \
#   -H "Content-Type: application/json" \
#   -d '{"url":"https://<your-api-host>/api/chat/webhook","secret_token":"<value-below>"}'
TELEGRAM_WEBHOOK_SECRET=
